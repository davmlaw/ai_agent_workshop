#!/usr/bin/env python3
"""mytools -- a small reimplementation of a subset of bedtools.

Subcommands arrive one issue at a time; see SPEC.md. Real bedtools is the oracle:
if our output differs from it byte-for-byte on the same input, we are wrong.

Implemented so far: --version, sort, merge, intersect.
"""

import sys

VERSION = "0.1.0"

USAGE = """usage: mytools --version
       mytools sort -i <file|->
       mytools merge -i <file|-> [-d N]
       mytools intersect -a <file|-> -b <file> [-u | -v | -wa]"""

# Lines bedtools skips silently rather than parsing as intervals (SPEC.md section 2).
SKIP_PREFIXES = ("#", "track", "browser")


class DataError(Exception):
    """Bad input data. Exit 1 (SPEC.md section 7)."""


class UsageError(Exception):
    """Bad invocation. Exit 2 (SPEC.md section 7)."""


class BufferedStdout:
    """stdout writer whose pending output is dropped when we exit with an error.

    bedtools prints nothing on stdout when it hits an out-of-order record, even
    for the intervals it had already merged and "printed": its output sits in a
    buffer that the error path never flushes. The golden tests diff stdout byte
    for byte, so we do the same. The buffer is bounded, so merge still streams.
    """

    LIMIT = 1 << 16

    def __init__(self, stream):
        self._stream = stream
        self._parts = []
        self._size = 0

    def write(self, text):
        self._parts.append(text)
        self._size += len(text)
        if self._size >= self.LIMIT:
            self.flush()

    def flush(self):
        if self._parts:
            self._stream.write("".join(self._parts))
            self._parts = []
            self._size = 0
        self._stream.flush()

    def discard(self):
        self._parts = []
        self._size = 0


def parse_line(fields, source, lineno):
    """Validate one split BED line, returning (chrom, start, end).

    BED is 0-based half-open, so start == end (zero-length) is legal and common in
    the fixtures; only start > end is an error.
    """
    if len(fields) < 3:
        raise DataError(f"{source}:{lineno}: fewer than 3 columns")

    chrom = fields[0]
    try:
        start = int(fields[1])
        end = int(fields[2])
    except ValueError:
        raise DataError(
            f"{source}:{lineno}: non-integer coordinate ({fields[1]}, {fields[2]})"
        )
    if start < 0 or end < 0:
        raise DataError(f"{source}:{lineno}: negative coordinate ({start}, {end})")
    if start > end:
        raise DataError(f"{source}:{lineno}: start > end ({start} > {end})")

    return chrom, start, end


def parse_bed_line(line, path, lineno, ncols):
    """Parse one BED line into (chrom, start, end, fields).

    Returns None for comment/track/browser/blank lines, which are skipped
    silently (SPEC.md section 2). `ncols` is the column count established by the
    first data line of this file, or None if this is that line. Coordinate
    validation is parse_line's job, so there is only ever one of it.
    """
    line = line.rstrip("\r\n")
    if not line.strip() or line.startswith(SKIP_PREFIXES):
        return None

    fields = line.split("\t")
    # Stricter than bedtools, which tolerates ragged files (SPEC.md sections 2, 8).
    if ncols is not None and len(fields) != ncols:
        raise DataError(f"{path}:{lineno}: {len(fields)} columns, expected {ncols}")

    chrom, start, end = parse_line(fields, path, lineno)
    return chrom, start, end, fields


def read_bed(stream, name):
    """Yield (chrom, start, end, fields, lineno) for each interval line.

    Takes an open stream rather than a path so callers can feed it a StringIO;
    `open_input` turns a path or "-" into one. Aborts at the first bad line
    rather than skipping it -- bedtools does.

    Coordinates come through exactly as written; the zero-length quirk lives in
    merge() and fudge().
    """
    ncols = None
    for lineno, line in enumerate(stream, start=1):
        record = parse_bed_line(line, name, lineno, ncols)
        if record is None:
            continue
        if ncols is None:
            ncols = len(record[3])
        yield record[0], record[1], record[2], record[3], lineno


def iter_bed(handle, name):
    """read_bed without the line number, for callers that do not report one."""
    for chrom, start, end, fields, _lineno in read_bed(handle, name):
        yield chrom, start, end, fields


def open_input(path):
    """Open path for reading, or stdin for `-`. Returns (stream, display name)."""
    if path == "-":
        return sys.stdin, "<stdin>"
    try:
        return open(path, "r"), path
    except OSError as exc:
        # A file the caller named but we cannot open is a caller problem, so
        # exit 2. bedtools exits 1 here; SPEC.md section 7 makes exit 2 our own
        # contract and keeps it out of the golden tests.
        raise UsageError(f"cannot open {path}: {exc.strerror}") from None


def parse_sort_args(args):
    """Return the input path for `sort`, or raise UsageError."""
    path = None
    rest = list(args)
    while rest:
        arg = rest.pop(0)
        if arg == "-i":
            if not rest:
                raise UsageError("sort: -i requires a file argument")
            if path is not None:
                raise UsageError("sort: -i given more than once")
            path = rest.pop(0)
        else:
            raise UsageError(f"sort: unrecognised argument: {arg}")
    if path is None:
        raise UsageError("sort: -i is required")
    return path


def cmd_sort(argv):
    """sort -i <file|->: chrom lexicographically, then start, then end."""
    path = parse_sort_args(argv)
    stream, name = open_input(path)
    try:
        # sort is the one subcommand allowed to hold the whole input in memory
        # (SPEC.md section 6).
        records = list(read_bed(stream, name))
    finally:
        if stream is not sys.stdin:
            stream.close()

    # Chrom sorts lexicographically, not numerically, so chr17 precedes chr7.
    # Python compares strings by code point; bedtools compares std::string bytes.
    # These agree for the ASCII chromosome names BED uses.
    #
    # The end key is what SPEC.md section 5 asks for, and it matches bedtools on
    # every committed fixture. It is worth knowing that bedtools itself does *not*
    # order ties by end: measured on v2.31.1, three records at chr1 500 with ends
    # 600/500/550 come back in input order, and its sort is not stable at scale
    # either. So among records sharing chrom and start, bedtools' row order is
    # arbitrary and byte-identity is not guaranteed in general -- only on inputs
    # like ours, where the ties happen to already be in end order. Sorting by end
    # and relying on Python's stable sort is the deterministic reading of that.
    records.sort(key=lambda record: (record[0], record[1], record[2]))

    out = sys.stdout
    for record in records:
        out.write("\t".join(record[3]) + "\n")
    return 0


def _cluster_row(chrom, start, end, count, original):
    """The output row for one finished cluster.

    A cluster of one prints the coordinates as they appeared in the file:
    bedtools only lets the zero-length inflation below reach the output when the
    feature actually merged with something. `chr1 500 500` alone prints
    `chr1 500 500`, but next to `chr1 500 600` it prints `chr1 499 600`.
    """
    if count == 1:
        return chrom, original[0], original[1]
    return chrom, start, end


def merge(records, d, name):
    """Merge sorted records, yielding (chrom, start, end) rows. Streams.

    Two features join when the gap between them is <= d. The gap between
    `chr1 100 200` and `chr1 200 300` is 0, so bookended features merge at the
    default d of 0 -- even though they do not *overlap* (SPEC.md section 3). A
    negative d demands that much overlap instead, as in bedtools.
    """
    seen_chroms = set()
    prev_chrom = None
    prev_start = None
    cluster = None  # (chrom, start, end, count, original)

    for chrom, start, end, _fields, lineno in records:
        if chrom != prev_chrom:
            if chrom in seen_chroms:
                raise DataError(
                    f"{name}:{lineno}: chrom {chrom} seen again after {prev_chrom}; "
                    "merge requires sorted input"
                )
            seen_chroms.add(chrom)
            prev_chrom = chrom
            prev_start = None
        # Sortedness is judged on the coordinates as written, before the
        # zero-length inflation below, which is what bedtools compares too.
        if prev_start is not None and start < prev_start:
            raise DataError(
                f"{name}:{lineno}: out of order record ({chrom} {start} {end}); "
                "merge requires sorted input"
            )
        prev_start = start

        # bedtools inflates a zero-length feature by one base on each side before
        # merging, so `chr1 500 500` reaches out to 499 and 501. Nobody predicts
        # this; it is measured, not reasoned about (SPEC.md section 3).
        if start == end:
            lo, hi = start - 1, end + 1
        else:
            lo, hi = start, end

        if cluster is not None and cluster[0] == chrom and lo - cluster[2] <= d:
            # Input is sorted by start, so the cluster keeps the first record's
            # start and only ever grows to the right.
            cluster = (chrom, cluster[1], max(cluster[2], hi), cluster[3] + 1, cluster[4])
        else:
            if cluster is not None:
                yield _cluster_row(*cluster)
            cluster = (chrom, lo, hi, 1, (start, end))

    if cluster is not None:
        yield _cluster_row(*cluster)


def parse_merge_args(args):
    """Return (input path, d) for `merge`, or raise UsageError."""
    path = None
    d = 0
    i = 0
    while i < len(args):
        arg = args[i]
        if arg in ("-i", "-d"):
            if i + 1 >= len(args):
                raise UsageError(f"merge: {arg} requires an argument")
            value = args[i + 1]
            if arg == "-i":
                path = value
            else:
                try:
                    d = int(value)
                except ValueError:
                    raise UsageError(f"merge: -d requires an integer, got {value!r}") from None
            i += 2
        else:
            raise UsageError(f"merge: unknown argument {arg!r}")
    if path is None:
        raise UsageError("merge: -i is required")
    return path, d


def cmd_merge(argv):
    """merge -i <file|-> [-d N]: collapse overlapping/nearby sorted features."""
    path, d = parse_merge_args(argv)
    stream, name = open_input(path)
    out = BufferedStdout(sys.stdout)
    try:
        for chrom, start, end in merge(read_bed(stream, name), d, name):
            out.write(f"{chrom}\t{start}\t{end}\n")
        out.flush()
    except DataError:
        out.discard()
        raise
    finally:
        if stream is not sys.stdin:
            stream.close()
    return 0


# --------------------------------------------------------------------------
# Interval semantics
# --------------------------------------------------------------------------
#
# BED is 0-based, half-open: chr1 100 200 covers bases 100..199. Two intervals
# overlap iff a.start < b.end AND b.start < a.end -- strict < on both sides, so
# bookended features (a.end == b.start) do NOT overlap.
#
# Zero-length features are the exception, and are not guessable. Measured
# against bedtools v2.31.1:
#
#     a = chr1 0 100, b = chr1 50 50   ->  chr1 49 51
#     a = chr1 0 100, b = chr1 100 100 ->  chr1 99 100
#     a = chr1 100 100, b = chr1 0 100 ->  chr1 100 100
#     a = chr1 100 100, b = chr1 99 99 ->  chr1 100 100
#     a = chr1 100 100, b = chr1 98 98 ->  (nothing)
#
# The model that reproduces every one of those: a zero-length feature is
# inflated by one base on each side before the overlap test, on BOTH sides of
# the comparison. The clipped output region is then computed from -a's
# ORIGINAL coordinates against -b's INFLATED ones -- note the asymmetry, which
# is why `a = chr1 100 100, b = chr1 0 100` prints 100 100 and not 99 100.


def fudge(start, end):
    """Inflate a zero-length interval by 1bp each side, as bedtools does."""
    if start == end:
        return start - 1, end + 1
    return start, end


def overlaps(a_start, a_end, b_start, b_end):
    """True iff the two intervals share a base. Coordinates must be fudged."""
    return a_start < b_end and b_start < a_end


# --------------------------------------------------------------------------
# The -b index
# --------------------------------------------------------------------------
#
# bedtools files every -b feature into a UCSC-style bin: seven levels, the
# finest 2^14 = 16kb wide and each level 8x coarser. A query walks the finest
# level first, ascending bin number, then each coarser level in turn; within a
# bin, features come back in the order they were read.
#
# We copy that scheme rather than the sorted-array-plus-binary-search of
# SPEC §6, because the search order IS the output order. Sorting -b hits by
# start gives the wrong answer on the committed fixture: a02 (chr1 100 200)
# overlaps b02 (chr1 100 100) and b03 (chr1 180 220), and bedtools prints the
# b03 intersection first, because b03 is the earlier line in b.bed and both
# land in the same bin. Both schemes are O(n log n)-ish and neither is
# quadratic, so SPEC §6's real requirement still holds.

_BIN_FIRST_SHIFT = 14   # finest bins are 2^14 = 16 kb
_BIN_NEXT_SHIFT = 3     # each level up is 8x coarser
_BIN_LEVELS = 7


def bin_for(start, end):
    """The (level, index) bin a feature is filed under."""
    end -= 1
    start >>= _BIN_FIRST_SHIFT
    end >>= _BIN_FIRST_SHIFT
    for level in range(_BIN_LEVELS):
        if start == end:
            return level, start
        start >>= _BIN_NEXT_SHIFT
        end >>= _BIN_NEXT_SHIFT
    # Wider than the coarsest bin: bedtools drops it in bin 0 of the top level.
    return _BIN_LEVELS - 1, 0


def bins_to_search(start, end):
    """Bin keys overlapping [start, end), in bedtools' traversal order."""
    start_bin = start >> _BIN_FIRST_SHIFT
    end_bin = (end - 1) >> _BIN_FIRST_SHIFT
    for level in range(_BIN_LEVELS):
        for index in range(start_bin, end_bin + 1):
            yield level, index
        start_bin >>= _BIN_NEXT_SHIFT
        end_bin >>= _BIN_NEXT_SHIFT


def load_b(path):
    """Read -b fully into memory: {chrom: {bin: [(start, end), ...]}}.

    Coordinates are stored already fudged, because that is what every later
    comparison wants. No v1 flag prints any -b column, so only the coordinates
    are kept.
    """
    handle, name = open_input(path)
    index = {}
    try:
        for chrom, start, end, _fields in iter_bed(handle, name):
            start, end = fudge(start, end)
            index.setdefault(chrom, {}).setdefault(bin_for(start, end), []).append(
                (start, end)
            )
    finally:
        if handle is not sys.stdin:
            handle.close()
    return index


def find_hits(index, chrom, start, end):
    """Yield the fudged -b intervals overlapping [start, end), in bedtools order."""
    chrom_bins = index.get(chrom)
    if not chrom_bins:
        return
    for key in bins_to_search(start, end):
        bucket = chrom_bins.get(key)
        if bucket is None:
            continue
        for b_start, b_end in bucket:
            if overlaps(start, end, b_start, b_end):
                yield b_start, b_end


# --------------------------------------------------------------------------
# intersect
# --------------------------------------------------------------------------


def cmd_intersect(argv, out=None):
    """mytools intersect -a <file|-> -b <file> [-u | -v | -wa]"""
    out = out if out is not None else sys.stdout
    a_path = b_path = None
    mode = None  # None (clipped default), "u", "v" or "wa"

    args = list(argv)
    while args:
        arg = args.pop(0)
        if arg in ("-a", "-b"):
            if not args:
                raise UsageError(f"{arg} requires a file argument")
            value = args.pop(0)
            if arg == "-a":
                a_path = value
            else:
                b_path = value
        elif arg in ("-u", "-v", "-wa"):
            flag = arg.lstrip("-")
            if mode is not None and mode != flag:
                raise UsageError(f"-{mode} and {arg} are mutually exclusive")
            mode = flag
        else:
            raise UsageError(f"unknown argument: {arg}")

    if a_path is None:
        raise UsageError("intersect requires -a")
    if b_path is None:
        raise UsageError("intersect requires -b")
    if b_path == "-":
        raise UsageError("-b must be a real file; it is read fully into memory")

    index = load_b(b_path)

    a_handle, a_name = open_input(a_path)
    write = out.write
    try:
        # -a streams and its input order is preserved: bedtools does not sort
        # -a and neither do we.
        for chrom, start, end, fields in iter_bed(a_handle, a_name):
            f_start, f_end = fudge(start, end)
            hits = find_hits(index, chrom, f_start, f_end)

            if mode == "u":
                if next(hits, None) is not None:
                    write("\t".join(fields) + "\n")
            elif mode == "v":
                if next(hits, None) is None:
                    write("\t".join(fields) + "\n")
            elif mode == "wa":
                original = "\t".join(fields) + "\n"
                for _hit in hits:
                    write(original)
            else:
                trailing = fields[3:]
                for b_start, b_end in hits:
                    # -a's ORIGINAL coordinates against -b's fudged ones.
                    row = [chrom, str(max(start, b_start)), str(min(end, b_end))]
                    row.extend(trailing)
                    write("\t".join(row) + "\n")
    finally:
        if a_handle is not sys.stdin:
            a_handle.close()
    return 0


COMMANDS = {"sort": cmd_sort, "merge": cmd_merge, "intersect": cmd_intersect}


def main(argv):
    if argv == ["--version"]:
        print(f"mytools {VERSION}")
        return 0

    try:
        if not argv:
            raise UsageError("no subcommand given")
        command, rest = argv[0], argv[1:]
        if command not in COMMANDS:
            raise UsageError(f"unknown subcommand: {command}")
        return COMMANDS[command](rest)
    except UsageError as err:
        # Errors go to stderr, never stdout -- stdout is data and gets piped.
        print(f"mytools: {err}", file=sys.stderr)
        print(USAGE, file=sys.stderr)
        return 2
    except DataError as err:
        print(f"mytools: {err}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
