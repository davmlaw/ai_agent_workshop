#!/usr/bin/env python3
"""mytools -- a small reimplementation of a subset of bedtools.

Subcommands arrive one issue at a time; see SPEC.md. Real bedtools is the oracle:
if our output differs from it byte-for-byte on the same input, we are wrong.

Implemented so far: --version, sort.
"""

import sys

VERSION = "0.1.0"

USAGE = "usage: mytools --version\n       mytools sort -i <file|->"

# Lines bedtools skips silently rather than parsing as intervals (SPEC.md section 2).
SKIP_PREFIXES = ("#", "track", "browser")


class DataError(Exception):
    """Bad input data. Exit 1 (SPEC.md section 7)."""


class UsageError(Exception):
    """Bad invocation. Exit 2 (SPEC.md section 7)."""


def parse_line(fields, source, lineno):
    """Validate one split BED line, returning (chrom, start, end).

    BED is 0-based half-open, so start == end (zero-length) is legal and common in
    the fixtures; only start > end is an error.
    """
    if len(fields) < 3:
        raise DataError(f"{source}:{lineno}: fewer than 3 columns")

    chrom = fields[0]
    try:
        start = int(fields[1])
        end = int(fields[2])
    except ValueError:
        raise DataError(
            f"{source}:{lineno}: non-integer coordinate ({fields[1]}, {fields[2]})"
        )
    if start < 0 or end < 0:
        raise DataError(f"{source}:{lineno}: negative coordinate ({start}, {end})")
    if start > end:
        raise DataError(f"{source}:{lineno}: start > end ({start} > {end})")

    return chrom, start, end


def read_bed(path):
    """Yield (chrom, start, end, fields) for each interval line in a BED file.

    `path` may be "-" for stdin. Comment, track, browser and blank lines are
    skipped silently, as bedtools does. Every line must carry the same number of
    columns: that is stricter than bedtools and is a deliberate deviation
    (SPEC.md section 8).
    """
    if path == "-":
        handle, source, close = sys.stdin, "stdin", False
    else:
        try:
            handle, close = open(path, "r"), True
        except OSError as err:
            # A file the caller named but we cannot open is a caller problem, so
            # exit 2. bedtools exits 1 here; SPEC.md section 7 makes exit 2 our own
            # contract and keeps it out of the golden tests.
            raise UsageError(f"cannot open {path}: {err.strerror}")
        source = path

    ncols = None
    try:
        for lineno, line in enumerate(handle, start=1):
            line = line.rstrip("\n").rstrip("\r")
            if not line.strip() or line.startswith(SKIP_PREFIXES):
                continue

            fields = line.split("\t")
            if ncols is None:
                ncols = len(fields)
            elif len(fields) != ncols:
                raise DataError(
                    f"{source}:{lineno}: {len(fields)} columns, expected {ncols}"
                )

            chrom, start, end = parse_line(fields, source, lineno)
            yield chrom, start, end, fields
    finally:
        if close:
            handle.close()


def cmd_sort(argv):
    """sort -i <file|->: chrom lexicographically, then start, then end."""
    path = None
    args = list(argv)
    while args:
        arg = args.pop(0)
        if arg == "-i":
            if not args:
                raise UsageError("sort: -i requires a file argument")
            if path is not None:
                raise UsageError("sort: -i given more than once")
            path = args.pop(0)
        else:
            raise UsageError(f"sort: unrecognised argument: {arg}")
    if path is None:
        raise UsageError("sort: -i is required")

    # sort is the one subcommand allowed to hold the whole input in memory
    # (SPEC.md section 6).
    records = list(read_bed(path))

    # Chrom sorts lexicographically, not numerically, so chr17 precedes chr7.
    # Python compares strings by code point; bedtools compares std::string bytes.
    # These agree for the ASCII chromosome names BED uses.
    #
    # The end key is what SPEC.md section 5 asks for, and it matches bedtools on
    # every committed fixture. It is worth knowing that bedtools itself does *not*
    # order ties by end: measured on v2.31.1, three records at chr1 500 with ends
    # 600/500/550 come back in input order, and its sort is not stable at scale
    # either. So among records sharing chrom and start, bedtools' row order is
    # arbitrary and byte-identity is not guaranteed in general -- only on inputs
    # like ours, where the ties happen to already be in end order. Sorting by end
    # and relying on Python's stable sort is the deterministic reading of that.
    records.sort(key=lambda record: (record[0], record[1], record[2]))

    out = sys.stdout
    for _chrom, _start, _end, fields in records:
        out.write("\t".join(fields) + "\n")
    return 0


def main(argv):
    if argv == ["--version"]:
        print(f"mytools {VERSION}")
        return 0

    try:
        if not argv:
            raise UsageError("no subcommand given")
        command, rest = argv[0], argv[1:]
        if command == "sort":
            return cmd_sort(rest)
        raise UsageError(f"unknown subcommand: {command}")
    except UsageError as err:
        # Errors go to stderr, never stdout -- stdout is data and gets piped.
        print(f"mytools: {err}", file=sys.stderr)
        print(USAGE, file=sys.stderr)
        return 2
    except DataError as err:
        print(f"mytools: {err}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
